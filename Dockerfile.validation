FROM rust:1.99.1-slim-bookworm@sha256:a24e292b4af7bdee351a31d3a6379972a5652f0ea22a1b6d6883324ac4f5097c
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml build.rs ./
COPY src ./src
RUN cargo build --release --locked && cargo test --locked
RUN python3 -m venv /opt/verify
COPY requirements-dev.txt ./
RUN /opt/verify/bin/python -m pip install --no-cache-dir -r requirements-dev.txt
COPY tests ./tests
COPY tools ./tools
COPY results/native-macos-arm64 ./results/native-macos-arm64
RUN useradd --uid 10001 --create-home validator
USER validator
ENV PROXY_BINARY=/app/target/release/tiny-fair-proxy
CMD ["/opt/verify/bin/python", "-m", "unittest", "discover", "-s", "tests", "-v"]
